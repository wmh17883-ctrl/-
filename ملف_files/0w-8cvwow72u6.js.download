          };
          anchorProto.dispatchEvent = function (event) {
            const call = () => superProto.dispatchEvent.call(this, event);
            return event instanceof RealMouseEvent && event.type === 'click' ? callHearingMissed(this, event.bubbles, call) : call();
          };
        }

        const originalOpen = window.open;
        window.open = function (url) {
          realParent.postMessage({
            type: "openExternal",
            href: url,
          }, "*");
        };

        window.addEventListener('error', (event) => {
          realParent.postMessage({ type: 'console', message: 'Uncaught Error: ' + event.message }, '*');
        });

        // Last, so that a throw here leaves the bridge laid.
        // As join(' ') words each argument, but for a Symbol or an object with no toString, at which join throws in the page's own call.
        const worded = (arg) => {
          try {
            return RealString(arg ?? '');
          } catch {
            return '[object Object]';
          }
        };
        [['log', ''], ['error', 'Error: '], ['warn', 'Warning: ']].forEach(([method, prefix]) => {
          if (typeof window.console?.[method] !== 'function') return;
          const native = window.console[method].bind(window.console);
          window.console[method] = (...args) => {
            native(...args);
            realParent.postMessage({ type: 'console', message: prefix + args.map(worded).join(' ') }, '*');
          };
        });
      })();
